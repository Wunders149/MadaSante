# Server port (Render sets PORT automatically)
PORT=3001

# JWT signing secret — REQUIRED in production, the server refuses to boot
# without it (or with the development placeholder). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production

# Supabase Postgres connection string
# Percent-encode special characters in the password (# -> %23, $ -> %24, etc.)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xtyrxzovwaopgdzxshkz.supabase.co:5432/postgres

# TLS for Postgres (required by Supabase). Set to false only for local Postgres.
PG_SSL=true

# Super admin bootstrapped on server start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Extra origins allowed to call the API cross-origin, comma separated.
# Leave empty in production: the API also serves the built SPA, so real traffic
# is same-origin and needs no CORS grant. Only set this if a separate frontend
# host is used.
CORS_ORIGINS=
