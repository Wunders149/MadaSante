# Server port (Render sets PORT automatically)
PORT=3001

# JWT signing secret — replace in production
JWT_SECRET=change-me-in-production

# Supabase Postgres connection string
# Percent-encode special characters in the password (# -> %23, $ -> %24, etc.)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xtyrxzovwaopgdzxshkz.supabase.co:5432/postgres

# TLS for Postgres (required by Supabase). Set to false only for local Postgres.
PG_SSL=true

# Super admin bootstrapped on server start
ADMIN_EMAIL=
ADMIN_PASSWORD=